# =============================================================
# Helper-ABI — .gitignore
# =============================================================

# ---------- Secrets & environments ----------
# Every env file is private except the public template.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ---------- Node / pnpm ----------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ---------- Build output ----------
dist/
build/
out/
.vite/
.turbo/
storybook-static/

# ---------- Test & coverage ----------
coverage/
.nyc_output/
junit.xml
test-results/
playwright-report/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
htmlcov/

# ---------- Databases ----------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ---------- Project data (private / generated) ----------
# Death screenshots and recordings are personal.
data/screenshots/*
!data/screenshots/.gitkeep
data/recordings/*
!data/recordings/.gitkeep
# DB exports may contain personal raid/death history.
data/exports/*
!data/exports/.gitkeep
# Raw downloaded content and caches from connectors.
data/raw/
data/cache/
uploads/

# ---------- Logs ----------
logs/
*.log

# ---------- Docker ----------
docker-compose.override.yml

# ---------- OS ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editors / IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ---------- Claude Code (local, per-machine) ----------
.claude/settings.local.json
CLAUDE.local.md

# ---------- Temporary ----------
tmp/
temp/
*.tmp
*.bak

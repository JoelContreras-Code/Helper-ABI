# Normalize line endings in the repository (LF), regardless of OS.
* text=auto eol=lf

# Windows scripts must keep CRLF to run correctly.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp4  binary
*.sqlite binary
*.db   binary

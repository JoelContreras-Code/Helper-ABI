# =============================================================
# Helper-ABI - environment template (public, NO real secrets)
# -------------------------------------------------------------
# Copy this file to .env.development (scripts/setup.ps1 does it
# for you and generates a random INGEST_TOKEN).
# Files .env.* are git-ignored, except this template.
# =============================================================

# development | test | production
NODE_ENV=development

# ---------- API (apps/api) ----------
# Bind to localhost only: personal use, never exposed to the network.
API_HOST=127.0.0.1
API_PORT=4000
# Only origin allowed by CORS (the web panel).
WEB_ORIGIN=http://127.0.0.1:5173
# Shared secret between Python workers and POST /api/ingest.
# Use a long random value (setup.ps1 generates one).
INGEST_TOKEN=change-me-to-a-long-random-string

# ---------- Database (used from phase 2) ----------
# sqlite (development/test) | postgres (optional production)
DB_DIALECT=sqlite
DB_STORAGE=./data/helper-abi.development.sqlite
# DATABASE_URL=postgres://helper_abi:<password>@127.0.0.1:5432/helper_abi

# ---------- Optional PostgreSQL via Docker (docker-compose.yml) ----------
# POSTGRES_USER=helper_abi
# POSTGRES_PASSWORD=<choose-a-strong-password>
# POSTGRES_DB=helper_abi

# ---------- Local AI: LM Studio ----------
LMSTUDIO_URL=http://localhost:1234/v1
LLM_TEXT_MODEL=qwen2.5-7b-instruct
LLM_VISION_MODEL=qwen2.5-vl-7b-instruct

# ---------- Python workers (services/) ----------
API_BASE_URL=http://127.0.0.1:4000
# Identifiable User-Agent and minimum delay between requests (>= 2000 ms).
HTTP_USER_AGENT=HelperABI-Centinela/0.1 (personal use)
HTTP_MIN_DELAY_MS=2000

# ---------- Optional connectors ----------
# YouTube Data API v3 key (free, Google Cloud Console). See docs/05-sources.md
YOUTUBE_API_KEY=
# Bot token for your OWN Discord server (announcement follow). Optional.
DISCORD_BOT_TOKEN=
